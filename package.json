{
  "name": "agriplan-pwa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "npm i": "pnpm i",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf node_modules .next",
    "clean:lock": "rm -f .next/dev/lock",
    "clean:cache": "pnpm store prune && rm -rf node_modules .next",
    "prepare": "husky install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "type-check": "tsc --noEmit",
    "ts-type-check": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "seed:base": "tsx scripts/danger/seed-base.ts",
    "seed:historic-prices": "npx tsx scripts/danger/seed-historic-prices.mts",
    "db:delete": "tsx scripts/danger/db-delete.ts",
    "seed:owner": "tsx scripts/safe/seed-layouts/owner.ts",
    "seed:demo": "tsx scripts/safe/seed-layouts/demo.ts",
    "seed:portero": "npx tsx scripts/safe/seed/seed-proyecto-portero.mts",
    "seed:estanquero": "npx tsx scripts/safe/seed/seed-terrenos-ia-experta.mts",
    "audit:integridad": "tsx scripts/safe/audit/integridad-dominio.ts",
    "audit:verify-seed": "npx tsx scripts/safe/audit/verify-seed-proyectos.mts",
    "audit:roi": "npx tsx scripts/safe/audit/audit-roi.mts",
    "audit:analisis-roi": "npx tsx scripts/safe/audit/analisis-roi.mts",
    "audit:compare-seed": "npx tsx scripts/safe/audit/compare-seed-vs-supabase.mts",
    "audit:verify-sync": "npx tsx scripts/safe/audit/verify-sync.ts",
    "audit:precios": "npx tsx scripts/safe/audit/verify-precios-calidad.mts",
    "audit:precios:compare": "npx tsx scripts/safe/audit/verify-precios-calidad.mts --compare",
    "db:migrate": "npx supabase db push"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@mercadopago/sdk-react": "^1.0.7",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/rbush": "^4.0.0",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.0",
    "mercadopago": "^2.12.0",
    "next": "16.1.4",
    "pixi.js": "^8.15.0",
    "rbush": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/serviceworker": "^0.0.179",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^20.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html}": [
      "prettier --write"
    ]
  }
}
